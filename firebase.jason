{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "README.md",
      "server.py"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "backend_server"
      }
    ]
  },
  "functions": {
    "source": ".",
    "codebase": "default",
    "runtime": "python311"
  }
}
